# Copy this file to .env and fill in what you need.
#
#     copy .env.example .env
#
# .env is git-ignored and must stay that way - it holds a real key. This file,
# with no real value in it, is the one that gets committed, so that anybody
# setting the project up can see what is needed without being told.
#
# A variable already set in the real environment wins over anything here, and
# a command line option wins over both.

# --------------------------------------------------------------------------
# Secrets
# --------------------------------------------------------------------------

# One per provider that needs a key. Which provider needs which is in
# config.PROVIDERS, under "key_env"; a provider nothing points at can be
# left empty.

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# https://api.experientiallabs.ai - a gateway key, sent as a Bearer token.
EXPERIENTIALLABS_API_KEY=

# https://huggingface.co/settings/tokens - a token allowed to make calls to
# Inference Providers. The router at router.huggingface.co/v1 speaks the
# ordinary OpenAI chat API, so it needs no code of its own.
HUGGINGFACE_API_KEY=

# https://build.nvidia.com - NVIDIA speaks the ordinary OpenAI chat
# API too, so it needs no code of its own either.
NVIDIA_API_KEY=

# --------------------------------------------------------------------------
# Which model does what
# --------------------------------------------------------------------------

# Where Ollama runs. It is not on this machine.
#OLLAMA_BASE_URL=http://192.168.178.54:11434

# One variable per role. The value is a NAME FROM config.MODELS - not a model
# id and not a provider. config.py holds the catalogue and the defaults; these
# override it without editing code, and GET /modele lists what may go here.
#
# cv_writer and cv_reviewer MUST be models of different families: a model
# grading its own work grades it kindly, and pre-flight refuses to start
# otherwise. cv_agent has to be a model declared with "supports_tools".
#ROLE_CRITERIA_SEARCHER=gemma4:31b-ollama
#ROLE_OFFER_MATCHER=nemotron-3-ultra-openrouter
#ROLE_CV_WRITER=minimax-m3-openrouter
#ROLE_CV_REVIEWER=nemotron-3-ultra-openrouter
#ROLE_CV_AGENT=nemotron-3-ultra-openrouter

# --------------------------------------------------------------------------
# Thresholds and limits - every one of them also has a command line option
# --------------------------------------------------------------------------

# How many offers are enough to stop relaxing the search filters.
#MIN_OFFERS=10

# How many of the offers found may be put in front of the matching model.
# A ceiling, not a filter: reaching it is a warning in the report.
#MAX_OFFERS_TO_ASSESS=50

# The mark out of 100 the matching model must give before a CV is written.
#MATCH_SCORE_THRESHOLD=70

# How many offers may reach CV writing, best first.
#MAX_OFFERS_FOR_CV=3

# The mark out of 100 at which a CV is good enough to stop revising it. Not
# a sharp line: the reviewing model is not repeatable, and two marks closer
# than SCORE_NOISE (config.py) say nothing about which document is better.
#CV_QUALITY_THRESHOLD=70

# How many documents may exist for one offer, the first one included.
#MAX_CV_VERSIONS=5

# How many turns the agent may take before the loop is cut off.
#MAX_AGENT_STEPS=16
